APP_NAME=TransitOps API
APP_DESCRIPTION=Backend API for the TransitOps Smart Transport Operations Platform.
APP_VERSION=0.1.0
APP_ENV=local
APP_DEBUG=true

API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://transitops:change-me@127.0.0.1:5433/transitops

SECRET_KEY=replace-with-a-secure-random-value-at-least-32-characters

JWT_ALGORITHM=HS256
JWT_ISSUER=transitops-api
JWT_AUDIENCE=transitops-web
ACCESS_TOKEN_EXPIRE_MINUTES=30

INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
INITIAL_ADMIN_FULL_NAME=TransitOps Administrator

ALLOWED_ORIGINS=["http://localhost:5173"]

LOG_LEVEL=INFO
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]